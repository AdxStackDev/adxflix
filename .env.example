# ──────────────────────────────────────────────
# Copy this file to .env.local for local dev,
# and set the same value in the Vercel dashboard:
#   Project → Settings → Environment Variables
# ──────────────────────────────────────────────

# Your TMDB "API Read Access Token" (Bearer token)
# Get it from https://www.themoviedb.org/settings/api
TMDB_BEARER=your_tmdb_read_access_token_here
